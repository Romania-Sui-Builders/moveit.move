
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}



model BoardCreated {
  dbId String @id @unique @default(uuid())
  board_id String
  name String
  created_by String
  version String
}

model BoardMigrated {
  dbId String @id @unique @default(uuid())
  board_id String
  old_version String
  new_version String
  migrated_by String
}

model ContributorAdded {
  dbId String @id @unique @default(uuid())
  board_id String
  contributor String
  added_by String
}

model StatusAdded {
  dbId String @id @unique @default(uuid())
  board_id String
  status String
  added_by String
}

model StatusRemoved {
  dbId String @id @unique @default(uuid())
  board_id String
  status String
  removed_by String
}

model TaskAssigned {
  dbId String @id @unique @default(uuid())
  board_id String
  task_id String
  assignees String[]
  assigned_by String
}

model TaskCreated {
  dbId String @id @unique @default(uuid())
  board_id String
  task_id String
  title String
  creator String
}

model TaskStatusChanged {
  dbId String @id @unique @default(uuid())
  board_id String
  task_id String
  old_status String
  new_status String
  changed_by String
}

model TaskUpdated {
  dbId String @id @unique @default(uuid())
  board_id String
  task_id String
  updated_by String
}


model cursor {
  id        String @id
  eventSeq  String
  txDigest  String
}